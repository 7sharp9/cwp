<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="BaselineTests.fs" />
    <Compile Include="SimulationTests.fs" />
    <Compile Include="RandomTests.fs" />
    <Compile Include="CanonicalHashTests.fs" />
    <Compile Include="ReplayTests.fs" />
    <Compile Include="BenchmarkTests.fs" />
    <Compile Include="FixtureTests.fs" />
    <Compile Include="TerrainTests.fs" />
    <Compile Include="SightTests.fs" />
    <Compile Include="PathfindingTests.fs" />
    <Compile Include="ScenarioTests.fs" />
    <Compile Include="DiagnosticsTests.fs" />
    <Compile Include="CorpusTests.fs" />
    <Compile Include="DeterminismPropertyTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden diagnostic renders are byte-compared against fresh renderer
         output in DiagnosticsTests.fs. Copy them next to the test assembly. -->
    <Content Include="..\..\content\diagnostics\*"
             Link="diagnostics\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- Committed replay corpus, byte-compared against fresh replay output in
         CorpusTests.fs. Copy them next to the test assembly. -->
    <Content Include="..\..\content\replays\*"
             Link="replays\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Generative determinism property tests (TASK-019, backlog B-012b
         narrowed). FsCheck.Xunit (not FsCheck.Xunit.v3) targets
         xunit.extensibility.execution [2.4.1, 3.0.0), matching the xunit 2.9.3
         v2 test project above. Test-only, same discipline as
         BenchmarkDotNet in bench/CommandoWar.Benchmarks: never referenced by
         CommandoWar.Sim or CommandoWar.Headless. -->
    <PackageReference Include="FsCheck" Version="3.3.4" />
    <PackageReference Include="FsCheck.Xunit" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CommandoWar.Sim\CommandoWar.Sim.fsproj" />
    <!-- Framework-neutral: the headless reference shares the spike fixture that
         FixtureTests.fs pins. No graphical or host dependency is introduced. -->
    <ProjectReference Include="..\..\src\CommandoWar.Headless\CommandoWar.Headless.fsproj" />
  </ItemGroup>

</Project>