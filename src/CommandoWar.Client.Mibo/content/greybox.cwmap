# CommandoWar framework-spike greybox (TASK-005 Mibo host)
# Hand-editable. Terrain and markers are CLIENT-ONLY: nothing here except the
# grid size, seed, and the six friendly spawns crosses the simulation boundary.
# Reproduces Setup.sixAgentWorld { 32; 32 } 20260902 exactly.
#
# format v1. one directive per line, '#' starts a comment.
#   size <w> <h>
#   seed <uint64>
#   terrain            then <h> rows of <w> chars: '.' floor, '#' wall
#   marker <kind> <id> <x> <y>   kind in { friendly, objective }
version 1
size 32 32
seed 20260902
terrain
................................
................................
................................
................................
..................#.............
..................#.............
..................#.............
..................#.............
................................
......#####.....................
......#.........................
......#.........................
......#.........................
.....................#..........
................................
....................#...........
................................
................................
........................####....
................................
.............#..................
.............#..................
.............#..................
.............#..................
.............#..................
................................
................................
................................
................................
................................
................................
................................
marker friendly 0 0 0
marker friendly 1 0 1
marker friendly 2 0 2
marker friendly 3 0 3
marker friendly 4 0 4
marker friendly 5 0 5
marker objective 0 20 14
