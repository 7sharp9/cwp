<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Baseline discipline: the authoritative simulation must build clean. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Baseline.fs" />
    <Compile Include="Ids.fs" />
    <Compile Include="Random.fs" />
    <Compile Include="Grid.fs" />
    <Compile Include="Terrain.fs" />
    <Compile Include="Sight.fs" />
    <Compile Include="Pathfinding.fs" />
    <Compile Include="Domain.fs" />
    <Compile Include="Perception.fs" />
    <Compile Include="Commands.fs" />
    <Compile Include="Scenario.fs" />
    <Compile Include="Events.fs" />
    <Compile Include="Snapshot.fs" />
    <Compile Include="Canonical.fs" />
    <Compile Include="Hashing.fs" />
    <Compile Include="Phases.fs" />
    <Compile Include="Simulation.fs" />
    <Compile Include="Replay.fs" />
    <Compile Include="ReplaySerialisation.fs" />
    <Compile Include="Divergence.fs" />
    <Compile Include="Diagnostics.fs" />
  </ItemGroup>

</Project>
