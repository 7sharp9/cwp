<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>cwheadless</AssemblyName>
    <RootNamespace>CommandoWar.Headless</RootNamespace>
    <!-- Same baseline discipline as the simulation library: this is the shared
         framework-neutral reference for both framework spikes. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CommandLogFile.fs" />
    <Compile Include="Fixture.fs" />
    <Compile Include="DemoScenario.fs" />
    <Compile Include="LosDemo.fs" />
    <Compile Include="PathDemo.fs" />
    <Compile Include="TurnDemo.fs" />
    <Compile Include="Corpus.fs" />
    <Compile Include="DiagnosticRender.fs" />
    <Compile Include="AppraisalDemo.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real Bridgehead mission content, read by the bridgehead-* corpus
         entries (TASK-077). Embedded rather than read from disk so cwheadless,
         the test assembly, and the Godot replay scene all see the same bytes
         regardless of working directory. -->
    <EmbeddedResource Include="..\..\content\scenarios\bridgehead.cwscenario" LogicalName="bridgehead.cwscenario" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommandoWar.Sim\CommandoWar.Sim.fsproj" />
  </ItemGroup>

</Project>
